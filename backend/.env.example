# Server Configuration
PORT=3001
NODE_ENV=development

# KICK OAuth2 Configuration
KICK_CLIENT_ID=your_kick_client_id_here
KICK_CLIENT_SECRET=your_kick_client_secret_here
KICK_REDIRECT_URI=http://localhost:3001/api/auth/callback

# OAuth Scopes (separated by spaces)
KICK_SCOPES=user:read channel:read channel:write chat:write streamkey:read events:subscribe moderation:ban

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Cookie Secret (generate a random string for production)
COOKIE_SECRET=your_secure_cookie_secret_here

# Session Configuration
SESSION_MAX_AGE=3600000
